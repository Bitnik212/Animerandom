# Copy to .env. Everything works as is for local development except ANNICT_TOKEN.

# --- Postgres -------------------------------------------------------------
POSTGRES_ADMIN_USER=anime
POSTGRES_ADMIN_PASSWORD=anime
INGEST_DB_PASSWORD=ingest-dev
API_DB_PASSWORD=api-dev
REC_DB_PASSWORD=rec-dev

# --- Elasticsearch, Redis -------------------------------------------------
ES_VERSION=8.19.4
ES_INDEX_VERSION=1

# --- Ingest worker --------------------------------------------------------
DJANGO_SECRET_KEY=change-me-for-anything-but-local
DJANGO_DEBUG=false
HTTP_USER_AGENT=anime-picker/0.1 (+https://github.com/bitnik212/animerandom)
# Personal access token from https://annict.com/settings/apps; without it Annict is skipped.
ANNICT_TOKEN=
RATE_ANILIST_PER_MIN=30
RATE_SHIKIMORI_PER_MIN=60
RATE_ANNICT_PER_MIN=30
INCREMENTAL_DAYS=3

# --- Keycloak -------------------------------------------------------------
KC_VERSION=26.7.4
KC_HOSTNAME=http://localhost:8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8180/realms/anime-picker
KEYCLOAK_REALM=anime-picker
KEYCLOAK_CLIENT_ID=anime-picker-api
# Secret of the anime-picker-api client. The realm import sets it from this
# variable, so Keycloak and the API always agree. Use a long random value outside dev.
KEYCLOAK_CLIENT_SECRET=dev-only-change-me
